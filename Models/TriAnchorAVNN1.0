"""
TriAnchorAVNN
=============

Static four-branch AVNN classifier with FAISS-accelerated KNN.
Operates in [-1,1] normalised space.

Four orthogonal branches in [-1,1] space
-----------------------------------------
  1. phi_dir_f  = arccos(x_f)      direction-aware angle    [0, π]
                  Small when x_f near +1, large when near -1.
                  Encodes both sign (which side of center) and
                  magnitude (how far from center) together.

  2. phi_mag_f  = arccos(|x_f|)    magnitude-only angle     [0, π/2]
                  References BOTH -1 and +1 boundaries symmetrically.
                  Small near either boundary, π/2 at center (x_f=0).
                  Encodes extremeness regardless of direction.
                  This is the "missing" branch — it captures what
                  arccos(x_f) and arccos(-x_f) can't independently
                  represent (arccos(-x_f) = π - arccos(x_f), redundant).

  3. euc_f      = tanh(arccos(x_f) * 0.8)   nonlinear transform
                  Arch-shaped, different curvature from branches 1&2.
                  Small near +1, near-plateau near -1.

  4. shape(x)   = (x - mean(x)) / std(x)   per-sample z-score
                  Magnitude-invariant within-sample feature profile.

Why these four are non-redundant
----------------------------------
  - Branch 1 vs 2: x_f=+0.8 → (0.644, 0.644); x_f=-0.8 → (2.498, 0.644)
    Branch 2 says they're equally extreme; branch 1 says they're far apart.
  - Branch 1 vs 3: tanh compression gives different curvature near extremes.
  - Branches 1-3 vs 4: shape normalises out magnitude entirely.

Combined vector (train == inference)
--------------------------------------
    combined = concat(
        √w_d * √fw * phi_dir,
        √w_m * √fw * phi_mag,
        √w_e * √fw * euc,
        √w_s *       shape,
    )

Squared L2 here equals the branch-weighted, feature-weighted sum of
squared per-branch distances. One metric, used identically for both
FAISS index and AVM centroids.
"""

import numpy as np
from sklearn.base import BaseEstimator, ClassifierMixin
from sklearn.utils.validation import check_is_fitted

try:
    import faiss
    _HAS_FAISS = True
except ImportError:
    _HAS_FAISS = False


class TriAnchorAVNN(BaseEstimator, ClassifierMixin):
    """
    Parameters
    ----------
    lam : float, default=0.7
        AVM vs KNN blend. 1.0 = pure AVM, no FAISS needed.
    k : int, default=5
    w_d, w_m, w_e, w_s : float
        Direction-angle, magnitude-angle, euclidean, shape branch weights.
        Normalised internally to sum to 1.
    feat_weights : array-like or None
        Per-feature weights applied to direction, magnitude, and euclidean
        branches. None = uniform.
    use_ivf, nlist, nprobe : FAISS IVF controls.
    """

    def __init__(self, lam=0.7, k=5,
                 w_d=0.28, w_m=0.24, w_e=0.24, w_s=0.24,
                 feat_weights=None, eps=1e-10,
                 use_ivf=True, nlist=1000, nprobe=10):
        self.lam          = lam
        self.k            = k
        self.w_d          = w_d
        self.w_m          = w_m
        self.w_e          = w_e
        self.w_s          = w_s
        self.feat_weights = feat_weights
        self.eps          = eps
        self.use_ivf      = use_ivf
        self.nlist        = nlist
        self.nprobe       = nprobe

    # ── preprocessing ─────────────────────────────────────────────────────────

    def _norm_fit(self, X):
        self.mn_  = X.min(0)
        self.rng_ = np.maximum(X.max(0) - self.mn_, 1e-10)

    def _norm_apply(self, X):
        """MinMax normalise to [-1, 1]."""
        return (-1.0 + 2.0 * (X - self.mn_) / self.rng_).astype(np.float32)

    # ── branch computations ───────────────────────────────────────────────────

    def _phi_dir(self, x):
        """Direction-aware angle: arccos(x_f) in [0, π]."""
        return np.arccos(np.clip(x, -1.0 + self.eps, 1.0 - self.eps)
                         ).astype(np.float32)

    def _phi_mag(self, x):
        """
        Magnitude angle: arccos(|x_f|) in [0, π/2].
        References BOTH ±1 boundaries symmetrically.
        Captures extremeness regardless of sign.
        """
        return np.arccos(np.clip(np.abs(x), 0.0, 1.0 - self.eps)
                         ).astype(np.float32)

    def _euc(self, x):
        """tanh_ac in [-1,1] space: scale=0.8."""
        return np.tanh(np.arccos(
            np.clip(x, -1.0 + self.eps, 1.0 - self.eps)) * 0.8
        ).astype(np.float32)

    @staticmethod
    def _shape(x, eps=1e-7):
        """Per-sample z-score normalisation."""
        mu = x.mean(1, keepdims=True)
        sd = x.std(1,  keepdims=True).clip(min=eps)
        return ((x - mu) / sd).astype(np.float32)

    # ── combined vector ───────────────────────────────────────────────────────

    def _combined(self, x_norm):
        """
        Four-branch combined vector.
        feat_weights applied to direction, magnitude, and euclidean.
        Shape is per-sample normalised so feat_weights don't apply.
        """
        phi_d = self._phi_dir(x_norm) * self._sqrt_fw_    # (N, F)
        phi_m = self._phi_mag(x_norm) * self._sqrt_fw_    # (N, F)
        euc   = self._euc(x_norm)     * self._sqrt_fw_    # (N, F)
        shape = self._shape(x_norm)                       # (N, F)

        return np.concatenate([
            self._s_d_ * phi_d,
            self._s_m_ * phi_m,
            self._s_e_ * euc,
            self._s_s_ * shape,
        ], axis=1).astype(np.float32)

    # ── fit ───────────────────────────────────────────────────────────────────

    def fit(self, X, y):
        X = np.asarray(X, dtype=np.float32)
        y = np.asarray(y)

        self.classes_    = np.unique(y)
        self.n_features_ = X.shape[1]

        # Branch weight sqrt scales
        total      = self.w_d + self.w_m + self.w_e + self.w_s
        self._s_d_ = np.float32(np.sqrt(self.w_d / total))
        self._s_m_ = np.float32(np.sqrt(self.w_m / total))
        self._s_e_ = np.float32(np.sqrt(self.w_e / total))
        self._s_s_ = np.float32(np.sqrt(self.w_s / total))

        # Per-feature weights
        if self.feat_weights is None:
            fw = np.ones(self.n_features_, dtype=np.float32)
        else:
            fw = np.asarray(self.feat_weights, dtype=np.float32)
            if len(fw) != self.n_features_:
                raise ValueError(
                    f"feat_weights length {len(fw)} != "
                    f"n_features {self.n_features_}")
        self._sqrt_fw_ = np.sqrt(np.maximum(fw, 0.0)).astype(np.float32)

        # Normalise and build combined vectors
        self._norm_fit(X)
        Xn       = self._norm_apply(X)
        combined = self._combined(Xn)

        # Class index mapping
        self.class_to_idx_    = {c: i for i, c in enumerate(self.classes_)}
        self.train_class_idx_ = np.array(
            [self.class_to_idx_[c] for c in y], dtype=np.int64)

        # AVM centroids in combined space
        self.centroids_ = np.stack([
            combined[y == c].mean(0) for c in self.classes_
        ]).astype(np.float32)

        # FAISS index
        if self.lam < 1.0:
            if not _HAS_FAISS:
                raise ImportError(
                    "faiss not installed. Install faiss-cpu or set lam=1.0.")
            dim = combined.shape[1]
            if self.use_ivf and combined.shape[0] >= 78:
                nlist = max(1, min(self.nlist, combined.shape[0] // 39))
                quantizer = faiss.IndexFlatL2(dim)
                index = faiss.IndexIVFFlat(quantizer, dim, nlist,
                                           faiss.METRIC_L2)
                index.train(combined)
                index.nprobe = self.nprobe
            else:
                index = faiss.IndexFlatL2(dim)
            index.add(combined)
            self.index_ = index

        return self

    # ── predict ───────────────────────────────────────────────────────────────

    def _avm_proba(self, combined):
        a_sq = (combined        ** 2).sum(1, keepdims=True)
        b_sq = (self.centroids_ ** 2).sum(1)
        ab   = combined @ self.centroids_.T
        d    = np.sqrt(np.maximum(
            a_sq + b_sq[None, :] - 2.0 * ab, 0.0)).astype(np.float32)
        raw  = 1.0 / (d + self.eps)
        return raw / raw.sum(1, keepdims=True)

    def _knn_proba(self, combined):
        dist, idx = self.index_.search(combined, self.k)
        w = 1.0 / (dist + self.eps)
        w = w / w.sum(1, keepdims=True)
        n_test = combined.shape[0]
        K      = len(self.classes_)
        proba  = np.zeros((n_test, K), dtype=np.float32)
        t_idx  = np.repeat(np.arange(n_test), self.k)
        np.add.at(proba,
                  (t_idx, self.train_class_idx_[idx.ravel()]),
                  w.ravel())
        return proba

    def predict_proba(self, X):
        check_is_fitted(self, 'centroids_')
        X        = np.asarray(X, dtype=np.float32)
        Xn       = self._norm_apply(X)
        combined = self._combined(Xn)
        avm      = self._avm_proba(combined)
        if self.lam >= 1.0:
            return avm
        return self.lam * avm + (1.0 - self.lam) * self._knn_proba(combined)

    def predict(self, X):
        return self.classes_[np.argmax(self.predict_proba(X), axis=1)]

    def summary(self, feature_names=None):
        check_is_fitted(self, 'centroids_')
        names = (list(feature_names) if feature_names is not None
                 else [f"f{i}" for i in range(self.n_features_)])
        total = self.w_d + self.w_m + self.w_e + self.w_s
        lines = [
            f"  lam={self.lam:.3f}  k={self.k}",
            f"  Branch weights:"
            f" direction={self.w_d/total:.3f}"
            f" magnitude={self.w_m/total:.3f}"
            f" euclidean={self.w_e/total:.3f}"
            f" shape={self.w_s/total:.3f}",
        ]
        if self.feat_weights is not None:
            fw    = np.asarray(self.feat_weights)
            order = np.argsort(fw)[::-1]
            lines.append("  Feature weights (top 5):")
            for i in order[:5]:
                lines.append(f"    {names[i]:<26} {fw[i]:.4f}")
        return "\n".join(lines)
